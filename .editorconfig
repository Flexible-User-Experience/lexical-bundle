# EditorConfig (https://editorconfig.org): what every editor should do with these files. The
# charset line is the reason this file exists: a save in a non-UTF-8 encoding twice turned every
# em dash, ellipsis, command symbol and middle dot in CHANGELOG.md into question marks. The rest
# states what the files already do, so nothing changes on save.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.md]
# Two-space list continuations, and a trailing double space is a hard line break in Markdown.
indent_size = 2
trim_trailing_whitespace = false

[*.svg]
# The Lucide icons ship without a final newline; keep them byte-identical to upstream.
insert_final_newline = false
